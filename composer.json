{
  "name": "restruct/silverstripe-latlongfield",
  "description": "Stand-alone latlong field, abstracted from mappable or a comparable module",
  "type": "silverstripe-vendormodule",
  "keywords": ["silverstripe", "mappable", "geocoding"],
  "license": "MIT",
  "authors": [
    {
      "name": "restruct"
    }],
  "autoload": {
    "psr-4": {
      "Restruct\\SilverStripe\\Forms\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\LatLong\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.1",
    "silverstripe/framework": "^5 || ^6",
    "silverstripe/vendor-plugin": "^2 || ^3",
    "ext-json": "*"
  },
  "require-dev": {
    "silverstripe/recipe-testing": "^3 || ^4"
  },
  "extra": {
    "expose": [
      "client"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
